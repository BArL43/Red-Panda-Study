# Public domain without https://. Its DNS A record must point to this VPS.
APP_DOMAIN=example.com

# Compass runs in the frontend server. Keep this value only on the server.
VIBE_API_KEY=
VIBE_MODEL=gpt-5.6-sol

# Go API administrator. Use a unique password of 16+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: shown only in internal runtime diagnostics.
APP_GIT_COMMIT=

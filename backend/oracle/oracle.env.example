# Public HTTPS address of this Oracle VM. A free DuckDNS domain is suitable.
API_DOMAIN=redpanda-study-api.duckdns.org

APP_ENV=production
ADMIN_EMAIL=admin@your-company.com
# Create a unique password of 16+ characters. Never put a real password in Git.
ADMIN_PASSWORD=replace-with-a-unique-16-plus-character-password

# Public address of the frontend, not the API address.
PUBLIC_APP_URL=https://red-panda-study.smart-ray-0878.chatgpt.site
ALLOWED_ORIGINS=https://red-panda-study.smart-ray-0878.chatgpt.site

SECURE_COOKIES=true
# The frontend and Oracle API use different domains, so browsers need this.
CROSS_SITE_COOKIES=true
SESSION_COOKIE=rps_session
SESSION_TTL=720h
INVITE_TTL=168h
